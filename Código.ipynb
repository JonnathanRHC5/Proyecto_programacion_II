   "source": [
    "%%writefile app.py\n",
    "from shiny.express import input, render, ui\n",
    "\n",
    "ui.input_slider(\"n\", \"Número\", 0, 100, 50)\n",
    "\n",
    "@render.text\n",
    "def resultado():\n",
    "    return f\"Elegiste {input.n()}\""
